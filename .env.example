# ========================================================
# LMS Environment Configuration
# ========================================================

# --- OPTION A: Supabase / PostgreSQL Configuration (Recommended) ---
# Paste your Supabase URI from: Project Settings -> Database -> Connection String -> URI
# Example Pooler (Port 6543): postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Example Direct (Port 5432): postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Alternatively, configure individual Supabase / PostgreSQL variables:
# DB_HOST=db.[YOUR-PROJECT-REF].supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=[YOUR-PASSWORD]
# DB_NAME=postgres
# DB_DIALECT=postgres

# --- OPTION B: Local MySQL Configuration (Alternative) ---
# If DATABASE_URL is commented out, the app will connect to MySQL:
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=lms_db
# DB_PORT=3306

# --- Authentication & Security ---
# Generate a strong 256-bit random string for production
JWT_SECRET_KEY=your_super_secret_jwt_key_here_change_in_production

# --- Stream Video & Audio SDK (getstream.io) ---
NEXT_PUBLIC_STREAM_API_KEY=your_stream_api_key_here
STREAM_SECRET_KEY=your_stream_secret_key_here

# --- AI / Machine Learning Service (Flask) ---
FLASK_SERVICE_URL=http://127.0.0.1:5000

# --- Application Environment ---
NODE_ENV=development
